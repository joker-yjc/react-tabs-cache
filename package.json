{
  "name": "@jcyao/react-tabs-cache",
  "version": "1.0.1",
  "description": "A universal React tabs cache component library with page state management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/joker-yjc/react-tabs-cache#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/joker-yjc/react-tabs-cache.git"
  },
  "bugs": {
    "url": "https://github.com/joker-yjc/react-tabs-cache/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:example": "vite --config example/vite.config.ts",
    "build": "tsc && vite build",
    "prepublishOnly": "npm run build",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "tabs",
    "cache",
    "state-management",
    "keep-alive",
    "antd",
    "react-router-dom",
    "multi-tabs",
    "hooks"
  ],
  "author": "joke_yao",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "antd": ">=5.0.0",
    "react-router-dom": ">=6.0.0"
  },
  "sideEffects": [
    "**/*.less",
    "**/*.css"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^0.34.0",
    "@vitest/ui": "^0.34.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.0.1",
    "less": "^4.5.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^0.34.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.5",
    "@types/react-router-dom": "^5.3.3",
    "ahooks": "^3.7.0",
    "antd": "^5.29.3",
    "debug": "^4.4.3",
    "mitt": "^3.0.1",
    "react-router-dom": "^6.30.3"
  }
}
